{
  "manifest_version": 3,
  "name": "bell bearer",
  "version": "1.0",
  "description": "bell bearer",
  "browser_specific_settings": {
    "gecko": {
      "id": "bell-bearer@example.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "tabs",
    "history",
    "sessions",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "bell bearer"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "transcript.js",
        "src/shared/time.js",
        "src/shared/dom.js",
        "src/shared/speed.js",
        "src/shared/settings.js",
        "src/shared/keybindings.js",
        "src/shared/skim.js",
        "src/shared/time-limits.js",
        "src/shared/youtube.js",
        "src/shared/bookmarks.js",
        "src/shared/pins.js",
        "src/shared/watched.js",
        "src/shared/subscriptions.js",
        "src/shared/feed.js",
        "src/shared/yt-subs.js",
        "src/shared/playlists.js",
        "src/shared/cookie-sites.js",
        "src/shared/x-pouch.js",
        "src/shared/pouch-button.js",
        "src/content/site.js",
        "src/content/notify.js",
        "src/content/overlay.js",
        "src/content/dom-watch.js",
        "src/content/theme.js",
        "src/content/page-info.js",
        "src/content/player.js",
        "src/content/shortcuts.js",
        "src/content/skim.js",
        "src/content/link-hints.js",
        "src/content/time-limit.js",
        "src/content/transcripts.js",
        "src/content/checkpoints.js",
        "src/content/markdown.js",
        "src/content/pouch-sheet.js",
        "src/content/youtube-ui.js",
        "src/content/twitter-page.js",
        "src/content/twitter-panel.js",
        "src/content/twitter-ui.js",
        "src/content/twitter-ads.js",
        "src/content/cookie-banner.js",
        "src/shared/chess-sites.js",
        "src/shared/chess-limits.js",
        "src/content/chess.js",
        "src/content/chess-limits.js",
        "src/content/main.js"
      ],
      "css": [
        "skin-fonts.css",
        "content.css"
      ]
    },
    {
      "matches": [
        "*://*.chess.com/*"
      ],
      "js": [
        "src/content/chess-page.js"
      ],
      "world": "MAIN"
    }
  ],
  "commands": {
    "copy-markdown-link": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Copy current page as a Markdown link"
    }
  },
  "background": {
    "scripts": [
      "src/shared/settings.js",
      "src/shared/activity.js",
      "src/shared/chess.js",
      "src/shared/lichess.js",
      "src/shared/chess-sites.js",
      "src/shared/chess-limits.js",
      "src/shared/trials.js",
      "src/shared/skim.js",
      "src/background/proto.js",
      "src/background/sowon.js",
      "src/background/context-menus.js",
      "src/background/commands.js",
      "src/background/activity-heartbeat.js",
      "src/background/chess-limits.js",
      "src/background/trials.js",
      "src/background/skim.js"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
