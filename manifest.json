{
  "manifest_version": 3,
  "name": "bell bearer",
  "version": "1.0",
  "description": "bell bearer",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "downloads",
    "activeTab",
    "scripting",
    "tabs",
    "history",
    "sessions",
    "tabGroups",
    "contextMenus",
    "clipboardWrite",
    "offscreen",
    "tts",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "bell bearer"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://youtu.be/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.reddit.com/*",
        "*://*.chess.com/*",
        "*://*.lichess.org/*",
        "*://*.leetcode.com/*",
        "*://*.typeracer.com/*",
        "*://*.chatgpt.com/*",
        "*://*.chat.openai.com/*",
        "*://*.claude.ai/*",
        "*://github.com/*",
        "*://gitlab.com/*",
        "*://codeberg.org/*",
        "*://vimeo.com/*",
        "*://www.vimeo.com/*",
        "*://*.netflix.com/*",
        "*://*.wikipedia.org/*"
      ],
      "js": [
        "src/shared/time.js",
        "src/shared/dom.js",
        "src/shared/icons.js",
        "src/shared/speed.js",
        "src/shared/settings.js",
        "src/shared/store.js",
        "src/shared/hosts.js",
        "src/shared/ids.js",
        "src/shared/keybindings.js",
        "src/shared/skim.js",
        "src/shared/limit-sites.js",
        "src/shared/time-limits.js",
        "src/shared/youtube.js",
        "src/shared/cookie-sites.js",
        "src/content/site.js",
        "src/content/notify.js",
        "src/content/overlay.js",
        "src/content/dom-watch.js",
        "src/content/theme.js",
        "src/content/page-info.js",
        "src/content/player.js",
        "src/content/shortcuts.js",
        "src/content/scroll-to.js",
        "src/content/skim.js",
        "src/content/link-hints.js",
        "src/content/time-limit.js",
        "src/content/markdown.js",
        "src/content/cookie-banner.js",
        "src/content/main.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "commands": {
    "copy-markdown-link": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Copy current page as a Markdown link"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "fonts/*.woff2",
        "textures/*.png",
        "content-reader.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
